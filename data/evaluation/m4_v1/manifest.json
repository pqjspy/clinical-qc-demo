    "protocols": {
      "schema_version": "m1-v1",
      "synthetic": true,
      "documents": [
        {
          "document_id": "SYN-DOC-PROTOCOL-001-v1",
          "study_id": "SYN-STUDY-001",
          "protocol_id": "SYN-PROTOCOL-001-v1",
          "version": "1",
          "effective_from": "2026-01-01T00:00:00+08:00",
          "effective_to": "2026-10-01T00:00:00+08:00",
          "sections": [
            {
              "section_id": "SEC-PK-001",
              "text": "【合成演示规则，非临床操作指引】本虚拟研究规定，同一PK样本从采血到开始离心的时间间隔至少为30分钟。小于30分钟时，提示“样本处理时间不足”，建议风险为中，建议判定为方案偏离，须人工复核。恰好30分钟不命中这一条规则；时间不完整、来源冲突或无法确认同一样本时须补充信息，不能自动通过。建议由负责人员确认样本是否被中心实验室接受，并评估检测结果是否有效。"
            },
            {
              "section_id": "SEC-VISIT-001",
              "text": "【合成演示规则，非临床操作指引】本虚拟研究将锚点日期记为第1天，第28天访视允许提前7天或延后7天，即实际访视日号在第21天至第35天之间，两个端点均包含。实际访视日号＝实际访视日期与锚点日期的自然日差＋1。超出此窗口时提示“访视超窗”，建议风险为中，建议判定为需人工判定，须人工复核。缺少锚点、实际日期或日号定义时不作超窗结论。建议复核访视日期来源与适用方案窗口，并记录原因。"
            },
            {
              "section_id": "SEC-AE-001",
              "text": "【合成演示规则，非临床操作指引】对本虚拟研究指定的不良事件登记册，只有同时明确“事件已发生”“已完整核对相关登记册”“该事件条目不存在”时，才提示“不良事件漏记”。未提供登记册或未完整核对，不等于漏记。命中时建议风险为高，建议判定为需人工判定，须人工复核并在本地工作台优先转交。urgent_flag只是案例提供的紧急线索，不由模型推断医学严重程度；这一高风险策略仅服务本演示。建议交由负责安全性记录的人员复核并补充缺失资料，不自动作医学处置。"
            },
            {
              "section_id": "SEC-DRUG-001",
              "text": "【合成演示规则，非临床操作指引】本虚拟研究对同一药品、中心、单位和结算期间采用：期末应有库存＝期初库存＋本期入库－本期发放＋确认退回可用库存的数量。五项数量均须明确且为非负整数；退回数量只指已确认重新计入可用库存的数量，不是所有回收药品。期末实盘与公式不一致时提示“试验用药账物不一致”，建议风险为中，建议判定为需人工判定，须人工复核。建议核对发放、退回、入库与盘点凭证；缺少数量不按0处理。"
            },
            {
              "section_id": "SEC-ROLE-001",
              "text": "【合成演示规则，非临床操作指引】本虚拟研究要求核对操作人与授权所指人员为同一人，操作名称在明确的授权操作清单内，且操作时点处于授权生效时间至授权结束时间的半开区间内：包含生效时点，不包含结束时点。身份不一致、操作不在范围内或时点越界时提示“操作超出授权范围”，建议风险为高，建议判定为需人工判定，须人工复核并在本地工作台优先转交。未提供授权材料不是已确认无授权。建议核查人员授权表、授权有效期及实际操作记录，不自动判断人员医学资质。"
            },
            {
              "section_id": "SEC-EDC-001",
              "text": "【合成演示规则，非临床操作指引】本虚拟研究仅在原始记录和EDC记录的受试者、字段、采集时点及单位均一致，且两侧值明确时进行精确值比较，不自动换算单位。对齐后值不同则提示“原始记录与 EDC 数据不一致”，建议风险为中，建议判定为需人工判定，须人工复核。无法对齐、任一值缺失或来源有多种矛盾记载时转交补充资料。建议核查原始记录与EDC录入来源并保留更正轨迹，不自行选择哪一侧是正确值。"
            }
          ]
        },
        {
          "document_id": "SYN-DOC-PROTOCOL-001-v2",
          "study_id": "SYN-STUDY-001",
          "protocol_id": "SYN-PROTOCOL-001-v2",
          "version": "2",
          "effective_from": "2026-10-01T00:00:00+08:00",
          "effective_to": null,
          "sections": [
            {
              "section_id": "SEC-PK-001",
              "text": "【合成演示规则，非临床操作指引】从2026年10月1日00:00:00+08:00起，本虚拟研究的v2方案将同一PK样本采血至开始离心的最小间隔改为20分钟，替代v1的30分钟要求。小于20分钟时提示“样本处理时间不足”，建议风险为中，建议判定为方案偏离，须人工复核。恰好20分钟不命中这一条规则；该更新不得改写此前已保存的分析结果。建议由负责人员确认样本是否被中心实验室接受，并评估检测结果是否有效。本v2演示只提供PK条款，不推断其他问题存在适用规则。"
            }
          ]
        },
        {
          "document_id": "SYN-DOC-PROTOCOL-CONFLICT-v1",
          "study_id": "SYN-STUDY-CONFLICT",
          "protocol_id": "SYN-PROTOCOL-CONFLICT-v1",
          "version": "1",
          "effective_from": "2026-01-01T00:00:00+08:00",
          "effective_to": null,
          "sections": [
            {
              "section_id": "SEC-PK-CONFLICT-A",
              "text": "【合成冲突测试材料，禁止作为正常规则发布示例】冲突研究的条款A要求同一PK样本从采血至开始离心至少30分钟；不足时提示“样本处理时间不足”，建议风险为中，建议判定为方案偏离，须人工复核。建议先由规则管理员核对冲突来源。条款A与条款B具有完全相同的适用范围和有效期，未声明替代关系；冲突未解决前不能任选其中一条形成结论。"
            },
            {
              "section_id": "SEC-PK-CONFLICT-B",
              "text": "【合成冲突测试材料，禁止作为正常规则发布示例】冲突研究的条款B要求同一PK样本从采血至开始离心至少20分钟；不足时提示“样本处理时间不足”，建议风险为中，建议判定为方案偏离，须人工复核。建议先由规则管理员核对冲突来源。条款B与条款A具有完全相同的适用范围和有效期，未声明替代关系；冲突未解决前不能任选其中一条形成结论。"
            }
          ]
        }
      ]
    },
