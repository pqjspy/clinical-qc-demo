    {
      "rule_id": "SYN-RULE-PK-001",
      "version": "1",
      "scope": {
        "study_id": "SYN-STUDY-001",
        "site_id": "SYN-SITE-A",
        "protocol_id": "SYN-PROTOCOL-001-v1",
        "effective_from": "2026-01-01T00:00:00+08:00",
        "effective_to": "2026-10-01T00:00:00+08:00"
      },
      "publication_status": "demo_approved",
      "check_type": "elapsed_minimum",
      "required_facts": [
        "collected_at",
        "centrifuged_at",
        "same_sample"
      ],
      "parameters": {
        "minimum_minutes": 30
      },
      "output_l3_id": "L3-PK-001",
      "risk": "中",
      "suggested_decision": "方案偏离",
      "suggested_action": "建议由负责人员确认样本是否被中心实验室接受，并评估检测结果是否有效。",
      "requires_human_review": true,
      "source": {
        "document_id": "SYN-DOC-PROTOCOL-001-v1",
        "section_id": "SEC-PK-001",
        "quote": "【合成演示规则，非临床操作指引】本虚拟研究规定，同一PK样本从采血到开始离心的时间间隔至少为30分钟。小于30分钟时，提示“样本处理时间不足”，建议风险为中，建议判定为方案偏离，须人工复核。恰好30分钟不命中这一条规则；时间不完整、来源冲突或无法确认同一样本时须补充信息，不能自动通过。建议由负责人员确认样本是否被中心实验室接受，并评估检测结果是否有效。"
      },
      "supersedes": []
    },
    {
      "rule_id": "SYN-RULE-VISIT-001",
      "version": "1",
      "scope": {
        "study_id": "SYN-STUDY-001",
        "site_id": "SYN-SITE-A",
        "protocol_id": "SYN-PROTOCOL-001-v1",
        "effective_from": "2026-01-01T00:00:00+08:00",
        "effective_to": "2026-10-01T00:00:00+08:00"
      },
      "publication_status": "demo_approved",
      "check_type": "visit_window",
      "required_facts": [
        "anchor_date",
        "actual_visit_date",
        "anchor_day_number"
      ],
      "parameters": {
        "target_day": 28,
        "early_days": 7,
        "late_days": 7,
        "anchor_day_number": 1,
        "boundary_inclusive": true
      },
      "output_l3_id": "L3-VISIT-001",
      "risk": "中",
      "suggested_decision": "需人工判定",
      "suggested_action": "建议复核访视日期来源与适用方案窗口，并记录原因。",
      "requires_human_review": true,
      "source": {
        "document_id": "SYN-DOC-PROTOCOL-001-v1",
        "section_id": "SEC-VISIT-001",
        "quote": "【合成演示规则，非临床操作指引】本虚拟研究将锚点日期记为第1天，第28天访视允许提前7天或延后7天，即实际访视日号在第21天至第35天之间，两个端点均包含。实际访视日号＝实际访视日期与锚点日期的自然日差＋1。超出此窗口时提示“访视超窗”，建议风险为中，建议判定为需人工判定，须人工复核。缺少锚点、实际日期或日号定义时不作超窗结论。建议复核访视日期来源与适用方案窗口，并记录原因。"
      },
      "supersedes": []
    },
    {
      "rule_id": "SYN-RULE-AE-001",
      "version": "1",
      "scope": {
        "study_id": "SYN-STUDY-001",
        "site_id": "SYN-SITE-A",
        "protocol_id": "SYN-PROTOCOL-001-v1",
        "effective_from": "2026-01-01T00:00:00+08:00",
        "effective_to": "2026-10-01T00:00:00+08:00"
      },
      "publication_status": "demo_approved",
      "check_type": "explicit_absence",
      "required_facts": [
        "event_present",
        "register_complete",
        "entry_present",
        "urgent_flag"
      ],
      "parameters": {
        "required_register": "本虚拟研究指定的不良事件登记册"
      },
      "output_l3_id": "L3-AE-001",
      "risk": "高",
      "suggested_decision": "需人工判定",
      "suggested_action": "建议交由负责安全性记录的人员复核并补充缺失资料，不自动作医学处置。",
      "requires_human_review": true,
      "source": {
        "document_id": "SYN-DOC-PROTOCOL-001-v1",
        "section_id": "SEC-AE-001",
        "quote": "【合成演示规则，非临床操作指引】对本虚拟研究指定的不良事件登记册，只有同时明确“事件已发生”“已完整核对相关登记册”“该事件条目不存在”时，才提示“不良事件漏记”。未提供登记册或未完整核对，不等于漏记。命中时建议风险为高，建议判定为需人工判定，须人工复核并在本地工作台优先转交。urgent_flag只是案例提供的紧急线索，不由模型推断医学严重程度；这一高风险策略仅服务本演示。建议交由负责安全性记录的人员复核并补充缺失资料，不自动作医学处置。"
      },
      "supersedes": []
    },
    {
      "rule_id": "SYN-RULE-DRUG-001",
      "version": "1",
      "scope": {
        "study_id": "SYN-STUDY-001",
        "site_id": "SYN-SITE-A",
        "protocol_id": "SYN-PROTOCOL-001-v1",
        "effective_from": "2026-01-01T00:00:00+08:00",
        "effective_to": "2026-10-01T00:00:00+08:00"
      },
      "publication_status": "demo_approved",
      "check_type": "inventory_balance",
      "required_facts": [
        "opening",
        "received",
        "dispensed",
        "returned_to_stock",
        "closing",
        "inventory_scope_confirmed"
      ],
      "parameters": {
        "formula": "opening + received - dispensed + returned_to_stock",
        "quantity_type": "non_negative_integer",
        "alignment_required": "同一药品、中心、单位和结算期间"
      },
      "output_l3_id": "L3-DRUG-001",
      "risk": "中",
      "suggested_decision": "需人工判定",
      "suggested_action": "建议核对发放、退回、入库与盘点凭证；缺少数量不按0处理。",
      "requires_human_review": true,
      "source": {
        "document_id": "SYN-DOC-PROTOCOL-001-v1",
        "section_id": "SEC-DRUG-001",
        "quote": "【合成演示规则，非临床操作指引】本虚拟研究对同一药品、中心、单位和结算期间采用：期末应有库存＝期初库存＋本期入库－本期发放＋确认退回可用库存的数量。五项数量均须明确且为非负整数；退回数量只指已确认重新计入可用库存的数量，不是所有回收药品。期末实盘与公式不一致时提示“试验用药账物不一致”，建议风险为中，建议判定为需人工判定，须人工复核。建议核对发放、退回、入库与盘点凭证；缺少数量不按0处理。"
      },
      "supersedes": []
    },
    {
      "rule_id": "SYN-RULE-ROLE-001",
      "version": "1",
      "scope": {
        "study_id": "SYN-STUDY-001",
        "site_id": "SYN-SITE-A",
        "protocol_id": "SYN-PROTOCOL-001-v1",
        "effective_from": "2026-01-01T00:00:00+08:00",
        "effective_to": "2026-10-01T00:00:00+08:00"
      },
      "publication_status": "demo_approved",
      "check_type": "authorization",
      "required_facts": [
        "actor_id",
        "authorized_actor_id",
        "operation_at",
        "authorized_from",
        "authorized_to",
        "operation",
        "authorized_operations"
      ],
      "parameters": {
        "authorization_interval": "[from,to)",
        "require_same_actor": true
      },
      "output_l3_id": "L3-ROLE-001",
      "risk": "高",
      "suggested_decision": "需人工判定",
      "suggested_action": "建议核查人员授权表、授权有效期及实际操作记录，不自动判断人员医学资质。",
      "requires_human_review": true,
      "source": {
        "document_id": "SYN-DOC-PROTOCOL-001-v1",
        "section_id": "SEC-ROLE-001",
        "quote": "【合成演示规则，非临床操作指引】本虚拟研究要求核对操作人与授权所指人员为同一人，操作名称在明确的授权操作清单内，且操作时点处于授权生效时间至授权结束时间的半开区间内：包含生效时点，不包含结束时点。身份不一致、操作不在范围内或时点越界时提示“操作超出授权范围”，建议风险为高，建议判定为需人工判定，须人工复核并在本地工作台优先转交。未提供授权材料不是已确认无授权。建议核查人员授权表、授权有效期及实际操作记录，不自动判断人员医学资质。"
      },
      "supersedes": []
    },
    {
      "rule_id": "SYN-RULE-EDC-001",
      "version": "1",
      "scope": {
        "study_id": "SYN-STUDY-001",
        "site_id": "SYN-SITE-A",
        "protocol_id": "SYN-PROTOCOL-001-v1",
        "effective_from": "2026-01-01T00:00:00+08:00",
        "effective_to": "2026-10-01T00:00:00+08:00"
      },
      "publication_status": "demo_approved",
      "check_type": "aligned_value_match",
      "required_facts": [
        "source_subject_id",
        "edc_subject_id",
        "source_field",
        "edc_field",
        "source_timepoint",
        "edc_timepoint",
        "source_unit",
        "edc_unit",
        "source_value",
        "edc_value"
      ],
      "parameters": {
        "comparison": "exact",
        "require_alignment": true
      },
      "output_l3_id": "L3-EDC-001",
      "risk": "中",
      "suggested_decision": "需人工判定",
      "suggested_action": "建议核查原始记录与EDC录入来源并保留更正轨迹，不自行选择哪一侧是正确值。",
      "requires_human_review": true,
      "source": {
        "document_id": "SYN-DOC-PROTOCOL-001-v1",
        "section_id": "SEC-EDC-001",
        "quote": "【合成演示规则，非临床操作指引】本虚拟研究仅在原始记录和EDC记录的受试者、字段、采集时点及单位均一致，且两侧值明确时进行精确值比较，不自动换算单位。对齐后值不同则提示“原始记录与 EDC 数据不一致”，建议风险为中，建议判定为需人工判定，须人工复核。无法对齐、任一值缺失或来源有多种矛盾记载时转交补充资料。建议核查原始记录与EDC录入来源并保留更正轨迹，不自行选择哪一侧是正确值。"
      },
      "supersedes": []
    },
